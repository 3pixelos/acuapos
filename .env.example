# Acua POS — client environment (Vite exposes only VITE_* to the browser).
# Copy to .env and fill in Acua's OWN Supabase project (created in Phase 2).
# NEVER put the service-role key here — anon key only.
VITE_SUPABASE_URL=https://YOUR-ACUA-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-acua-anon-key
